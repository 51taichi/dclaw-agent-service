{
  "name": "dclaw-agent-service",
  "version": "0.1.0",
  "description": "Channel-neutral customer service runtime for DClaw agents",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js",
    "client:dev:h5": "npm --prefix clients/channel-app run dev:h5",
    "client:build:h5": "npm --prefix clients/channel-app run build:h5",
    "client:build:mp-weixin": "npm --prefix clients/channel-app run build:mp-weixin",
    "client:open:mp-weixin": "npm --prefix clients/channel-app run open:mp-weixin",
    "credentials:migrate-wechat": "node scripts/migrate-wechat-credentials.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  }
}
