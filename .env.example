PORT=4310
HOST=127.0.0.1
DATABASE_PATH=./data/dclaw-agent.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:4310
AGENT_TIMEOUT_MS=90000
DELIVERY_MAX_ATTEMPTS=3

# OpenAI-compatible speech-to-text endpoint (multipart/form-data)
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_LANGUAGE=zh
SPEECH_TIMEOUT_MS=60000

# Encrypts workspace credentials stored in the database
CREDENTIAL_ENCRYPTION_KEY=
WECHAT_SESSION_TTL_DAYS=30

# Legacy one-time import only; leave empty after running credentials:migrate-wechat
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# Docker Compose host settings
DCLAW_AGENT_PORT=4310
DCLAW_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:4310
DCLAW_AGENT_DATA_DIR=../data
