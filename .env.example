PORT=4310
HOST=127.0.0.1
DATABASE_PATH=./data/dclaw-agent.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:4310
AGENT_TIMEOUT_MS=90000
DELIVERY_MAX_ATTEMPTS=3

# OpenAI-compatible speech-to-text endpoint. Leave empty for direct npm start;
# Docker Compose injects its local ASR endpoint automatically.
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=small
SPEECH_LANGUAGE=zh
SPEECH_TIMEOUT_MS=60000

# Local Faster-Whisper resource settings
DCLAW_ASR_PORT=18000
DCLAW_ASR_MODEL_DIR=../asr-models
DCLAW_ASR_CPU_THREADS=2
DCLAW_ASR_BEAM_SIZE=5
DCLAW_ASR_CPUS=2.0
DCLAW_ASR_MEMORY_LIMIT=3g
HF_ENDPOINT=https://huggingface.co
PIP_INDEX_URL=https://pypi.org/simple

# Encrypts workspace credentials stored in the database
CREDENTIAL_ENCRYPTION_KEY=
WECHAT_SESSION_TTL_DAYS=30

# Admin authentication. Use a strong password in production.
ADMIN_AUTH_REQUIRED=true
PLATFORM_ADMIN_PASSWORD=
# 0 keeps admin sessions valid until logout, password change, or cookie removal.
ADMIN_SESSION_TTL_HOURS=0

# Legacy one-time import only; leave empty after running credentials:migrate-wechat
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# Docker Compose host settings
DCLAW_AGENT_PORT=4310
DCLAW_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:4310
DCLAW_AGENT_DATA_DIR=../data
